# North Applications Backend
# Copie este arquivo para .env no ambiente local ou cadastre estas variaveis no painel da ShardCloud.
# Nunca commite o arquivo .env real.

# Runtime
NODE_ENV=production
PORT=8080

# URLs publicas
FRONTEND_URL=https://SEU-FRONTEND.vercel.app
FRONTEND_URL_SECONDARY=
BACKEND_URL=https://SEU-BACKEND.shardweb.app
COOKIE_DOMAIN=
TRUSTED_IPS=

# Banco principal
MONGODB_URI=mongodb+srv://USUARIO:SENHA@HOST/DATABASE?retryWrites=true&w=majority

# Banco usado pelos bots hospedados/configurados
MONGO_BOTS_URI=mongodb+srv://USUARIO:SENHA@HOST/BOTS_DATABASE?retryWrites=true&w=majority

# JWT / sessoes
JWT_SECRET=troque-por-uma-chave-com-mais-de-32-caracteres
JWT_ISSUER=north-backend
JWT_AUDIENCE=north-frontend

# Discord OAuth e automacoes do servidor
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_SCOPES=identify email guilds.join
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DEFAULT_ROLE_ID=
DISCORD_COUNTER_CHANNEL_ID=

# Email transacional
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@northapplications.com.br
EMAIL_FROM_NAME=North Applications

# Dados fiscais/recibos
CNPJ=

# Pagamentos
# Valores aceitos no codigo atual: efi, woovi ou mistic.
PAYMENT_PROVIDER=woovi

# Woovi / OpenPix
WOOVI_APP_ID=
WOOVI_API_KEY=
WOOVI_MOCK=false

# EFI Bank
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=
EFI_CERT_BASE64=
EFI_CERT_PASSWORD=
EFI_PIX_KEY=
EFI_MOCK=false

# Mistic
MISTIC_CLIENT=
MISTIC_SECRET=

# Integração legada Discloud usada para hospedar/gerenciar bots dos clientes.
# Mantenha vazio se a North for operar apenas via ShardCloud neste backend.
DISCLOUD_TOKEN=
DISCLOUD_API_TOKEN=
DISCLOUD_ZIP_PATH=
